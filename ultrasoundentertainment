:root {
    --text: #6641e9;
    --background: #ffffff;
    --primary: #ffa64e;
    --secondary: #ff5c43;
    --accent: #c86bff;
    --dark: #222222;
    --light: #f8f8ff;
    --border: #6641e9;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--background);
    color: var(--dark);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
}

#wrapper {
    width: 92%;
    max-width: 1200px;
    margin: 20px auto;
    border: 4px solid var(--border);
    background-color: var(--background);
}

/* HEADER */
.site-header {
    display: grid;
    grid-template-columns: 180px 1fr 320px;
    align-items: center;
    border-bottom: 4px solid var(--border);
    background-color: #fff7fd;
    min-height: 150px;
}

.logo-area {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 150px;
    border-right: 3px solid var(--border);
    padding: 15px;
    background-color: #fff0f8;
}

.logo-area img {
    width: 130px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
}

.brand-area {
    padding: 20px 25px;
}

.brand-area h1 {
    font-size: 2.4rem;
    color: var(--text);
    margin-bottom: 8px;
    border-bottom: 3px solid var(--accent);
    display: inline-block;
    padding-bottom: 4px;
}

.brand-area p {
    font-size: 1.15rem;
    color: var(--dark);
    font-weight: bold;
}

.social-area {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    min-height: 150px;
    background-color: #fff8f4;
}

.social-area a {
    text-decoration: none;
    color: var(--text);
    font-weight: bold;
    border: 2px solid var(--text);
    padding: 10px 14px;
    border-radius: 6px;
    background-color: white;
}

.social-area a:hover {
    background-color: var(--accent);
    color: white;
}

/* NAVIGATION */
.main-nav {
    display: grid;
    grid-template-columns: 1fr 220px;
    align-items: center;
    border-bottom: 4px solid var(--border);
    background-color: var(--primary);
    min-height: 85px;
}

.main-nav ul {
    list-style: none;
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    height: 100%;
}

.main-nav li {
    flex: 1;
    text-align: center;
    border-right: 2px solid rgba(0, 0, 0, 0.15);
}

.main-nav li:last-child {
    border-right: none;
}

.main-nav a {
    display: block;
    text-decoration: none;
    color: var(--dark);
    font-size: 1.2rem;
    font-weight: bold;
    padding: 24px 10px;
}

.main-nav a:hover {
    background-color: var(--secondary);
    color: white;
}

.search-area {
    text-align: center;
    font-size: 1.1rem;
    font-weight: bold;
    color: var(--dark);
    border-left: 3px solid var(--border);
    padding: 10px;
}

/* HERO */
.hero {
    min-height: 340px;
    border-bottom: 4px solid var(--border);
    background-image: linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)), url("images/hero.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px;
}

.hero-overlay {
    width: 100%;
    max-width: 850px;
    text-align: center;
    color: white;
    padding: 30px;
    border: 3px solid white;
    background-color: rgba(0, 0, 0, 0.15);
}

.hero-overlay h2 {
    font-size: 3rem;
    margin-bottom: 16px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.35);
}

.hero-overlay p {
    font-size: 1.2rem;
}

/* MAIN + SIDEBAR */
.content-layout {
    display: grid;
    grid-template-columns: 2fr 1.1fr;
    gap: 18px;
    padding: 18px;
    border-bottom: 4px solid var(--border);
    background-color: #fffefe;
}

.main-content,
.sidebar {
    border: 3px solid var(--border);
    padding: 18px;
    background-color: white;
}

.main-content {
    background-color: #fffaf5;
}

.sidebar {
    background-color: #f9f3ff;
}

.main-content h3,
.sidebar h3 {
    font-size: 1.8rem;
    margin-bottom: 18px;
    color: var(--text);
    border-bottom: 3px solid var(--primary);
    padding-bottom: 6px;
}

.content-image-box,
.video-box {
    border: 3px solid var(--border);
    height: 240px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 24px;
    font-size: 2rem;
    font-weight: bold;
    color: var(--dark);
    background: linear-gradient(135deg, #fff, #f2f2f2);
}

.main-content p {
    font-size: 1.05rem;
    color: var(--dark);
    margin-bottom: 24px;
}

.button-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.btn {
    text-decoration: none;
    padding: 12px 22px;
    font-weight: bold;
    border-radius: 6px;
    color: white;
    border: 2px solid transparent;
}

.primary-btn {
    background-color: var(--primary);
}

.secondary-btn {
    background-color: var(--secondary);
}

.btn:hover {
    border-color: var(--dark);
    opacity: 0.95;
}

.sidebar h4 {
    font-size: 1.2rem;
    margin-bottom: 12px;
    color: var(--dark);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 5px;
    display: inline-block;
}

.sidebar ul {
    list-style: none;
    margin-top: 10px;
}

.sidebar li {
    margin-bottom: 14px;
    padding: 8px 10px;
    border-left: 4px solid var(--secondary);
    background-color: white;
}

.sidebar a {
    text-decoration: none;
    color: var(--dark);
    font-size: 1.05rem;
    font-weight: bold;
}

/* GALLERY */
.gallery-section {
    padding: 20px;
    border-bottom: 4px solid var(--border);
    background-color: #fff7fb;
}

.gallery-section h3 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 18px;
    color: var(--text);
    border-bottom: 3px solid var(--accent);
    display: inline-block;
    width: 100%;
    padding-bottom: 8px;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.gallery-item {
    border: 3px solid var(--border);
    min-height: 130px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--dark);
    background: linear-gradient(135deg, #ffffff, #f0f0f0);
}

/* FOOTER */
.site-footer {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    min-height: 95px;
    flex-wrap: wrap;
    gap: 12px;
    padding: 16px;
    background-color: var(--secondary);
    border-top: 4px solid var(--border);
}

.site-footer a {
    text-decoration: none;
    color: white;
    font-weight: bold;
    font-size: 1.1rem;
    padding: 8px 14px;
    border: 2px solid white;
    border-radius: 4px;
}

.site-footer a:hover {
    background-color: white;
    color: var(--secondary);
}

/* TABLET */
@media (max-width: 900px) {
    .site-header {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .logo-area {
        border-right: none;
        border-bottom: 3px solid var(--border);
    }

    .social-area {
        min-height: auto;
        padding: 14px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .main-nav {
        grid-template-columns: 1fr;
    }

    .main-nav ul {
        flex-direction: column;
    }

    .main-nav li {
        border-right: none;
        border-bottom: 1px solid rgba(0, 0, 0, 0.15);
        width: 100%;
    }

    .search-area {
        border-left: none;
        border-top: 3px solid var(--border);
    }

    .content-layout {
        grid-template-columns: 1fr;
    }

    .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* PHONE */
@media (max-width: 600px) {
    .brand-area h1 {
        font-size: 1.8rem;
    }

    .hero-overlay h2 {
        font-size: 2rem;
    }

    .hero-overlay p {
        font-size: 1rem;
    }

    .gallery-grid {
        grid-template-columns: 1fr;
    }

    .site-footer {
        flex-direction: column;
    }
}

/* INNER PAGES */
.page-hero {
    min-height: 220px;
    border-bottom: 4px solid var(--border);
    background: linear-gradient(135deg, var(--primary), var(--secondary), var(--accent));
    color: white;
    text-align: center;
    padding: 50px 25px;
}

.page-hero h2 {
    font-size: 2.7rem;
    margin-bottom: 12px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.35);
}

.page-hero p {
    font-size: 1.15rem;
}

.page-content {
    padding: 24px;
    background-color: #fffaf5;
    border-bottom: 4px solid var(--border);
}

.intro-section {
    border: 3px solid var(--border);
    background-color: white;
    padding: 20px;
    margin-bottom: 22px;
}

.intro-section h3,
.package-section h3 {
    color: var(--text);
    font-size: 1.8rem;
    border-bottom: 3px solid var(--primary);
    padding-bottom: 6px;
    margin-bottom: 14px;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 24px;
}

.service-card {
    border: 3px solid var(--border);
    background-color: #f9f3ff;
    padding: 20px;
}

.service-card h3 {
    color: var(--text);
    margin-bottom: 10px;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 5px;
}

.package-section {
    border: 3px solid var(--border);
    background-color: white;
    padding: 20px;
    margin-bottom: 24px;
}

/* SERVICES TABLE */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
}

th {
    background-color: var(--primary);
    color: var(--dark);
}

th,
td {
    border: 2px solid var(--border);
    padding: 12px;
    text-align: left;
}

tr:nth-of-type(even) {
    background-color: #f9f3ff;
}

/* BOOKING FORM */
.booking-form {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    border: 3px solid var(--border);
    background-color: white;
    padding: 24px;
    max-width: 800px;
}

.booking-form label {
    font-weight: bold;
    color: var(--text);
}

.booking-form input,
.booking-form select,
.booking-form textarea {
    padding: 10px;
    border: 2px solid var(--border);
    font-size: 1rem;
    font-family: Arial, Helvetica, sans-serif;
}

.booking-form input[type="submit"] {
    grid-column: 2;
    width: 170px;
    background-color: var(--secondary);
    color: white;
    font-weight: bold;
    border: 2px solid var(--secondary);
    cursor: pointer;
}

.booking-form input[type="submit"]:hover {
    background-color: var(--accent);
    border-color: var(--accent);
}

/* INNER PAGE RESPONSIVE */
@media (max-width: 900px) {
    .services-grid {
        grid-template-columns: 1fr;
    }

    .booking-form {
        grid-template-columns: 1fr;
    }

    .booking-form input[type="submit"] {
        grid-column: 1;
    }
}

@media (max-width: 600px) {
    .page-hero h2 {
        font-size: 2rem;
    }

    table {
        font-size: 0.9rem;
    }

    th,
    td {
        padding: 8px;
    }
}

.content-image-box img,
.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
